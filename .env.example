# Copy to .env.local and fill in (see README)

# AI assistant ("Ask assistant"). Leave empty to keep the assistant switched off.
ANTHROPIC_API_KEY=
# Optional: model for the assistant (default claude-opus-5-5)
ASSISTANT_MODEL=

# Real complaint storage (otherwise demo mode, saved only in the visitor's browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# e.g. https://vinaydwivedi.in - used in share links and social previews
NEXT_PUBLIC_SITE_URL=
