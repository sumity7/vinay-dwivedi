# Copy to .env.local and fill in (see README)

# AI assistant ("Ask assistant"). Leave empty to keep the assistant switched off.
ANTHROPIC_API_KEY=
# Optional: model for the assistant (default claude-opus-5-5)
ASSISTANT_MODEL=

# Real complaint storage (otherwise demo mode, saved only in the visitor's browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# e.g. https://vinaydwivedi.in - used in share links, social previews, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=

# Website assistant (chat button). Either key switches it on; if both are set, Claude is used.
# Free option: a Groq API key from console.groq.com/keys (model openai/gpt-oss-120b, change with GROQ_MODEL).
GROQ_API_KEY=
GROQ_MODEL=

# Enquiry form -> e-mail. GMAIL_USER is the Gmail account that sends; GMAIL_APP_PASSWORD is a Google App Password for it
# (Google Account > Security > 2-Step Verification > App passwords). CONTACT_TO_EMAIL is who receives the enquiries.
# Leave GMAIL_USER empty and the form falls back to opening WhatsApp.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=Vinaydwivedi71@gmail.com

# Google Search Console: the content="..." token from the "HTML tag" verification method (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
